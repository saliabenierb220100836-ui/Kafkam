# ── Required ────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# ── Database (Railway sets this automatically) ───────────────────────────────
# Leave blank locally to use SQLite. Railway injects DATABASE_URL automatically.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Camera source (pick ONE of the two options below) ───────────────────────

# Option A: Real CCTV / IP camera via RTSP (best quality)
# Common formats:
#   Hikvision:  rtsp://admin:password@192.168.1.10:554/Streaming/Channels/101
#   Dahua:      rtsp://admin:password@192.168.1.10:554/cam/realmonitor?channel=1&subtype=0
#   Reolink:    rtsp://admin:password@192.168.1.10:554/h264Preview_01_main
#   Generic:    rtsp://192.168.1.10:554/stream1
# CAMERA_RTSP_URL=rtsp://admin:password@192.168.1.10:554/stream1

# Option B: Phone as IP camera via HTTP snapshot
# Android — install "IP Webcam" app, start server, note the IP:
# CAMERA_URL=http://192.168.1.50:8080/shot.jpg
#
# iOS — install "EpocCam" or "iVCam", use their MJPEG URL:
# CAMERA_URL=http://192.168.1.50:8080/video

# ── Display ──────────────────────────────────────────────────────────────────
CAMERA_NAME=Main Entrance

# ── Leave blank → demo mode (animated test pattern, no hardware needed) ──────
